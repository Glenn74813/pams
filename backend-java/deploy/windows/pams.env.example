# Copy to C:\PAMS\.env (same folder as pams-backend.jar) and fill in. Never commit the real file.

# SQL Server (2019 or later). The database must exist; PAMS creates its tables on first start.
MSSQL_URL=jdbc:sqlserver://DBSERVER:1433;databaseName=pams;encrypt=true;trustServerCertificate=false
MSSQL_USERNAME=pams_app
MSSQL_PASSWORD=change-me

# A long random secret (at least 64 characters) for signing sign-in tokens and QR links.
PAMS_JWT_SECRET=change-me-to-a-long-random-value
# Keys the audit-trail seals; set once (defaults to the JWT secret).
PAMS_AUDIT_SEAL_KEY=change-me-to-another-long-random-value

# HTTPS on this service (a .pfx exported with its private key). Leave SERVER_SSL_ENABLED=false
# and set SERVER_PORT=8095 if IIS or another reverse proxy terminates TLS in front of it.
SERVER_PORT=443
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=C:/PAMS/certs/pams.pfx
SERVER_SSL_KEY_STORE_PASSWORD=change-me
SERVER_SSL_KEY_STORE_TYPE=PKCS12
PAMS_REQUIRE_HTTPS=true

# The built web app (frontend-react/dist copied here) and where files and backups are kept.
PAMS_FRONTEND_DIR=C:/PAMS/web
PAMS_STORAGE_DIR=C:/PAMS/storage/public

# The address people open (QR labels link here); can also be set later in Settings → System.
PAMS_APP_URL=https://pams.agency.gov.ph

# Optional: single sign-on through an OpenID Connect provider (Entra ID, Google Workspace, Keycloak...).
# Register https://pams.agency.gov.ph/api/auth/sso/callback as the redirect URI with the provider.
#PAMS_SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#PAMS_SSO_CLIENT_ID=
#PAMS_SSO_CLIENT_SECRET=
#PAMS_SSO_BUTTON_LABEL=Sign in with the agency account

# Optional: an external digital signing platform (PNPKI). It calls /api/signing/platform/** with this key.
#PAMS_SIGNING_PLATFORM_KEY=a-long-random-value
#PAMS_SIGNING_PLATFORM_URL=https://signing.agency.gov.ph/api/requests
