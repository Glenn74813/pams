{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-java",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend-java && exec ./mvnw -q -B spring-boot:run"
      ],
      "port": 8095
    },
    {
      "name": "frontend-react",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend-react",
        "run",
        "dev"
      ],
      "port": 5190
    }
  ]
}
